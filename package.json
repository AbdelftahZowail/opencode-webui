{
  "name": "opencode-webui",
  "description": "Web UI for the OpenCode coding agent — chat, streaming, tool cards, and extensions over the OpenCode engine's HTTP API.",
  "private": false,
  "type": "module",
  "version": "1.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdelftahZowail/opencode-webui.git"
  },
  "keywords": [
    "opencode",
    "webui",
    "ai",
    "agent",
    "bun"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "opencode-webui": "./server/index.ts"
  },
  "files": [
    "dist",
    "server",
    "skills",
    "ui-extensions/README.md"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite",
    "dev:server": "bun run --watch server/index.ts",
    "preview": "bun run scripts/preview.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "regions": "bun run scripts/list-regions.ts",
    "gen:skill": "bun run scripts/gen-skill.ts",
    "check:swap": "bun run scripts/uitest/swap-ready.ts",
    "prepublishOnly": "bun run typecheck && bun run gen:skill && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@opencode-ai/client": "0.0.0-next-17444",
    "@shadcn/react": "^0.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
